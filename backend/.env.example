# Environment for the Magana backend (set in your shell, docker compose, or the host).
# Values here are placeholders; never commit real keys.

# development lets Explain use any engine (Kaggle only with our own test pages: docs/MODELS.md).
# tester and production allow only hosts approved in docs/MODELS.md. Unset counts as production.
MAGANA_ENV=development

# API key the app must send as X-Magana-Key (unset: no key needed, for local development).
MAGANA_API_KEY=

# Ibà triage service (iba-natlas /v1). Unset IBA_API_URL: Magana uses its built-in danger-sign rules.
IBA_API_URL=http://localhost:8000
IBA_API_KEY=

# OCR: tesseract (default) or paddle (needs requirements-paddle.txt); language for PaddleOCR.
MAGANA_OCR=tesseract
MAGANA_OCR_LANG=en

# Browser origins allowed to call the API (regex). Default: any localhost port.
MAGANA_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1)(:\d+)?

# Outage alert: if Ibà is unreachable for 10 minutes, one CRITICAL log line, plus a POST
# {"text": ...} here if set (e.g. a Slack incoming webhook). Leave empty for logs only.
MAGANA_ALERT_WEBHOOK_URL=
# How often to probe Ibà in the background, in seconds (0 = only when people use it).
IBA_PROBE_S=60

# Nurse / pharmacist desk that receives call-back requests (POST JSON). Unset: the app
# says call-backs are not available yet, instead of promising a call.
MAGANA_CALLBACK_URL=
