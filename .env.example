# Copy to .env (never committed) for `docker compose up`.
# Shared key between Magana and the Ibà service: any long random string, e.g. `openssl rand -hex 24`.
IBA_API_KEY=
# Where the iba-natlas repo's app/ folder is (default: next to this repo).
IBA_NATLAS_DIR=../iba-natlas/app
# OCR engine: tesseract (default) or paddle.
MAGANA_OCR=tesseract
# Optional: Slack-style webhook for the "Ibà unreachable for 10 minutes" alert.
MAGANA_ALERT_WEBHOOK_URL=

# Rate limits per minute (the web app's API key is public). Defaults shown; raise the IP
# ones if many testers share one school router.
# RATE_IP_PER_MIN=120
# RATE_DEVICE_PER_MIN=60
# RATE_HEAVY_IP_PER_MIN=30
# RATE_HEAVY_DEVICE_PER_MIN=12

# Teacher portal: quiz writes need this key in X-Magana-Teacher-Key (the app's key is public).
# Unset: only a MAGANA_ENV=development server accepts quizzes. e.g. `openssl rand -hex 24`.
MAGANA_TEACHER_KEY=
