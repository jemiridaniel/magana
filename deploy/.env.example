# Server settings for docker-compose.prod.yml. Copy to .env ON THE SERVER and fill in.
# Never commit the real .env (it is in .gitignore). Make keys with: openssl rand -hex 32

# The domain. Its A records (the bare name, api., app., teachers.) point at the Elastic IP;
# Caddy gets a certificate for each (deploy/Caddyfile).
MAGANA_DOMAIN=magana.ng
# The old address (the Elastic IP with dots as dashes + .sslip.io): still the API, for APKs
# built before 0.1.0+3. Remove it (and its block in the Caddyfile) once every tester has updated.
MAGANA_LEGACY_DOMAIN=18-130-12-34.sslip.io

# The app sends this as X-Magana-Key (build the APK with --dart-define=MAGANA_API_KEY=...).
MAGANA_API_KEY=
# The web app's and portal's key (Cloudflare Pages; a GitHub secret, public in their JavaScript).
# Rotate it without touching the APKs. docs/DEPLOY_PAGES.md, step 2.
MAGANA_WEB_API_KEY=

# Between Magana and Ibà (internal only).
IBA_API_KEY=

# Keys the class, session and teacher codes (codes.py). deploy/update.sh makes it on the
# server if it's missing; never change it once codes are in use (every code would stop working).
MAGANA_CODE_KEY=
# Teacher sign-in emails (mailer.py): ses (AWS SES through the instance role) or outbox (dev).
MAGANA_MAIL=ses
MAIL_FROM=Magana for Teachers <no-reply@magana.ng>
MAGANA_PORTAL_URL=https://teachers.magana.ng
# The Magana team are real accounts now (Owner, School reviewer, Support), not a list here. Make
# the first owner on the server, once:
#   sudo docker compose -f docker-compose.prod.yml exec magana python -m app.team_setup --email you@example.com --name "Your Name"
# Replies to Magana's emails (Cloudflare Email Routing forwards it to the support inbox):
MAIL_REPLY_TO=support@magana.ng


# Server speech recognition: device (off; the phone's own) or local (needs ~2.5 GB more
# memory than a t3.small has: docs/FINDINGS.md).
ASR_ENGINE=device

# tesseract (t3.small) or paddle (c7i-flex.large; see docs/DEPLOY_AWS.md first)
OCR_ENGINE=tesseract
MAGANA_OCR_LANG=en

# tester while testers use it, production later. Outside development, Explain only runs on a
# host listed as approved in docs/MODELS.md; otherwise the app says it isn't available yet.
MAGANA_ENV=production

# Explanations: stub (preview, no model) until N-ATLaS is served (docs/MODELS.md).
EXPLAIN_ENGINE=stub
EXPLAIN_URL=
EXPLAIN_API_KEY=

# WhatsApp (docs/WHATSAPP_SETUP.md). Leave empty to keep the webhook off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# off, or mms (MMS voices: needs requirements-asr.txt and about 0.8 GB more memory)
WHATSAPP_VOICE=off
# Free messages a month; Magana warns at 800 and stops (except emergencies) at this number.
WHATSAPP_MONTHLY_LIMIT=1000

# Optional
MAGANA_CALLBACK_URL=
MAGANA_ALERT_WEBHOOK_URL=
IBA_PROBE_S=60
# The browser origins allowed to call the API: the PWA and the portal (and the old address).
MAGANA_CORS_ORIGIN_REGEX=https://(app|teachers)\.magana\.ng|https://([a-z0-9-]+\.)?magana-(app|teachers)\.pages\.dev|https://18-130-12-34\.sslip\.io
