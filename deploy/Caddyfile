# Automatic HTTPS for Magana (certificates from Let's Encrypt, one per name below).
#   magana.ng            the website (deploy/site) and the Android download (deploy/downloads)
#   www.magana.ng        redirects to magana.ng
#   api.magana.ng        the API and the WhatsApp webhook
#   app.magana.ng        the tester PWA (deploy/web)
#   teachers.magana.ng   the teacher portal (deploy/teachers), behind a login
#   <ip>.sslip.io        the old address: still the API for APKs built before 0.1.0+3;
#                        /app and /teachers move to their subdomains
# MAGANA_DOMAIN (magana.ng) and MAGANA_LEGACY_DOMAIN come from the server's .env.

(common) {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(api) {
	# Page photos only: Magana never stores them.
	request_body {
		max_size 15MB
	}
	reverse_proxy {$MAGANA_UPSTREAM:magana:8000}
}

{$MAGANA_DOMAIN} {
	import common
	# No cookies, analytics or trackers: nothing on the site needs another origin.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
	handle_path /downloads/* {
		root * /srv/downloads
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition attachment
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		root * /srv/site
		@fresh path *.html */
		header @fresh Cache-Control "no-cache"
		try_files {path} {path}/ {path}.html
		file_server
	}
	handle_errors 404 {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

# www is a CNAME to the bare domain (Cloudflare, DNS only): send it there.
www.{$MAGANA_DOMAIN} {
	redir https://{$MAGANA_DOMAIN}{uri} 308
}

api.{$MAGANA_DOMAIN} {
	import common
	# The bare address is for people: send them to the website, not "bad_api_key".
	redir / https://{$MAGANA_DOMAIN}/ 302
	import api
}

app.{$MAGANA_DOMAIN} {
	import common
	root * /srv/app
	# Always check these for a newer version; the service worker caches the rest.
	@fresh path / /index.html /magana_sw.js /flutter_bootstrap.js /manifest.json
	header @fresh Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

teachers.{$MAGANA_DOMAIN} {
	import common
	# The portal has its own sign-in (email and a 6-digit code, portal_api.py) and carries no
	# key, so no basic auth here. "/" is Home; signed-out visitors go to Sign in.
	root * /srv/teachers
	@fresh path *.html */
	header @fresh Cache-Control "no-cache"
	file_server
}

{$MAGANA_LEGACY_DOMAIN} {
	import common
	redir / https://{$MAGANA_DOMAIN}/ 302
	# handle_path strips the prefix before the redirect inside it runs.
	redir /app https://app.{$MAGANA_DOMAIN}/ 308
	handle_path /app/* {
		redir https://app.{$MAGANA_DOMAIN}{uri} 308
	}
	redir /teachers https://teachers.{$MAGANA_DOMAIN}/ 308
	handle_path /teachers/* {
		redir https://teachers.{$MAGANA_DOMAIN}{uri} 308
	}
	# Everything else is the API, unchanged, for APKs built before 0.1.0+3.
	handle {
		import api
	}
}
